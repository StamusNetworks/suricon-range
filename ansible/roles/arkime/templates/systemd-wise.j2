[Unit]
Description=Arkime WISE
After=network.target

[Service]
Type=simple
Restart=on-failure
# StandardOutput=tty
EnvironmentFile=-/opt/arkime/etc/wise.env
# Modify /opt/arkime/etc/wise.env instead of ExecStart
ExecStart=/bin/sh -c '/opt/arkime/bin/node wiseService.js -c /opt/arkime/etc/wise.ini ${OPTIONS} >> /opt/arkime/logs/wise.log 2>&1'
WorkingDirectory=/opt/arkime/wiseService

[Install]
WantedBy=multi-user.target
