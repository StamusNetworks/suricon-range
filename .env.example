# Tuoni C2 API
TUONI_API=https://<tuoni-host>:8443
TUONI_USER=tuoni
TUONI_PASS=

# Targets — both FQDN and IP for each host
# Some techniques need IPs (Suricata EVE src_ip/dest_ip), others need
# domain names (SMB/WMI lateral movement uses FQDN).
TARGET_WS=<workstation-fqdn>
TARGET_WS_IP=<workstation-ip>
TARGET_DC=<dc-fqdn>
TARGET_DC_IP=<dc-ip>

# Initial compromise credentials (foothold on workstation)
EXEC_USER=<domain\user>
EXEC_PASS=

# Lateral movement credentials (privileged domain account)
LATERAL_USER=<DOMAIN\admin-user>
LATERAL_PASS=

# Elasticsearch / Kibana — for EVE log extraction
ELK_URL=http://<elk-host>:9200

# Arkime — for PCAP retrieval
ARKIME_URL=http://<arkime-host>:8005
ARKIME_USER=
ARKIME_PASS=

# Tuoni C2 server IP (for eve_filter callback tracking)
TUONI_IP=<tuoni-ip>

# LLM — findings generation (OpenAI-compatible API)
LLM_URL=https://openrouter.ai/api/v1
LLM_KEY=
LLM_MODEL=qwen/qwen3-235b-a22b-2507
